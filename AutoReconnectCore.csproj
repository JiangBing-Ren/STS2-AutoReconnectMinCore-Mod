<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AssemblyName>AutoReconnectMinCore</AssemblyName>
    <RootNamespace>AutoReconnect</RootNamespace>

    <Sts2Dir Condition="'$(STS2_GAME_DIR)' != ''">$(STS2_GAME_DIR)</Sts2Dir>
    <Sts2Dir Condition="'$(STS2_GAME_DIR)' == ''">D:\Steam\steamapps\common\Slay the Spire 2</Sts2Dir>
    <Sts2DataDir>$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>

    <!-- JmcModLib 路径：Steam Workshop 安装 -->
    <JmcModLibPublishDir Condition="'$(JmcModLibPublishDir)' == ''">D:\Steam\steamapps\workshop\content\2868840\3747526103\</JmcModLibPublishDir>
  </PropertyGroup>

  <!-- 导入 JML 构建属性，自动添加 JmcModLib.Runtime.dll 引用 -->
  <Import Project="$(JmcModLibPublishDir)JmcModLib.Sts2.props" Condition="Exists('$(JmcModLibPublishDir)JmcModLib.Sts2.props')" />

  <ItemGroup>
    <Compile Remove="tmp\**" />
    <!-- tools/ 是独立项目（sts2sig 等），其全局命名空间类型（如 Engine）会经默认 **/*.cs
         glob 混入本程序集并在简单名查找中击败 using Godot 的 Godot.Engine（CS0117），必须排除 -->
    <Compile Remove="tools\**" />
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Steamworks.NET">
      <HintPath>$(Sts2DataDir)\Steamworks.NET.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="STS2-RitsuLib">
      <HintPath>$(MSBuildProjectDirectory)\lib\STS2-RitsuLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyDllToProjectRoot" AfterTargets="Build">
    <Message Text="Copying Core DLL to project root..." Importance="high" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(MSBuildProjectDirectory)\$(AssemblyName).dll" />
  </Target>
</Project>
