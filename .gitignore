# ===== 日志（永不入库） =====
*.log

# ===== 诊断证据（日志/报告留在本地磁盘，不入库） =====
_evidence/

# ===== Godot / .NET 构建缓存 =====
.godot/
[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/
.idea/

# ===== 编译产物（DLL / 符号 / 依赖清单） =====
*.dll
*.pdb
*.deps.json
*.runtimeconfig.json

# ===== 部署产物（由 deploy.sh 从构建生成，不入库） =====
deploy/**/*.dll

# ===== 例外：本 mod 自身的发布 DLL 入库（最新 + 每版本归档 + 项目根构建副本，保留每一个版本） =====
!AutoReconnectMinCore.dll
!deploy/AutoReconnectMinCore/AutoReconnectMinCore.dll
!deploy/AutoReconnectMinCore/archive/**/AutoReconnectMinCore.dll

# ===== 例外：随 mod 发布的第三方运行时依赖库（非缓存，需入库） =====
!lib/
!lib/**
