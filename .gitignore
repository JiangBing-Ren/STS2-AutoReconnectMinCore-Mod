# ===== 日志（永不入库） =====
*.log

# ===== Godot / .NET 构建缓存 =====
.godot/
[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/
.idea/

# ===== 编译产物（DLL / 符号 / 依赖清单） =====
*.dll
*.pdb
*.deps.json
*.runtimeconfig.json

# ===== 部署产物（由 deploy.sh 从构建生成，不入库） =====
deploy/**/*.dll

# ===== 例外：随 mod 发布的第三方运行时依赖库（非缓存，需入库） =====
!lib/
!lib/**
